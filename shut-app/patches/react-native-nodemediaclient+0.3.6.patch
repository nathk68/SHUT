+// ── Orientation helpers ──────────────────────────────────────────────────────
+
+- (AVCaptureVideoOrientation)preferredVideoOrientation {
+    switch ([UIDevice currentDevice].orientation) {
+        case UIDeviceOrientationLandscapeLeft:
+            return AVCaptureVideoOrientationLandscapeRight;
+        case UIDeviceOrientationLandscapeRight:
+            return AVCaptureVideoOrientationLandscapeLeft;
+        case UIDeviceOrientationPortraitUpsideDown:
+            return AVCaptureVideoOrientationPortraitUpsideDown;
+        default:
+            return AVCaptureVideoOrientationPortrait;
+    }
+}
+
+// Returns the rotation angle (degrees) for videoRotationAngle (iOS 17+).
+// AVCaptureConnection.videoRotationAngle: 0=landscape-right, 90=portrait,
+// 180=landscape-left, 270=portrait-upside-down.
+- (CGFloat)rotationAngleForCurrentOrientation {
+    switch ([UIDevice currentDevice].orientation) {
+        case UIDeviceOrientationLandscapeLeft:      return 0.0;
+        case UIDeviceOrientationLandscapeRight:     return 180.0;
+        case UIDeviceOrientationPortraitUpsideDown: return 270.0;
+        default: /* Portrait */                     return 90.0;
+    }
+}
+
+// Finds the AVCaptureVideoPreviewLayer sublayer and applies the correct
+// orientation + gravity.  If the AVCaptureConnection is not yet established
+// (session still starting up), schedules itself to retry in 200 ms.
+- (void)applyPreviewOrientation {
+    for (CALayer *layer in self.layer.sublayers) {
+        if (![layer isKindOfClass:[AVCaptureVideoPreviewLayer class]]) continue;
+
+        AVCaptureVideoPreviewLayer *previewLayer = (AVCaptureVideoPreviewLayer *)layer;
+        previewLayer.videoGravity = AVLayerVideoGravityResizeAspectFill;
+
+        if (previewLayer.connection == nil) {
+            // Session not fully started yet — retry in 200 ms.
+            __weak typeof(self) weakSelf = self;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(200 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{
+                if (weakSelf.isPreview) [weakSelf applyPreviewOrientation];
+            });
+            return;
+        }
+
+        // iOS 17+ deprecates videoOrientation in favour of videoRotationAngle.
+        if (@available(iOS 17.0, *)) {
+            CGFloat angle = [self rotationAngleForCurrentOrientation];
+            if ([previewLayer.connection isVideoRotationAngleSupported:angle]) {
+                previewLayer.connection.videoRotationAngle = angle;
+            }
+        } else {
+            if (previewLayer.connection.isVideoOrientationSupported) {
+                previewLayer.connection.videoOrientation = [self preferredVideoOrientation];
+            }
+        }
+        return;
+    }
+}
