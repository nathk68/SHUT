rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isBroadcaster() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'broadcaster';
    }

    // ── Users ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Usernames (unique reservation) ──────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── Events (lives) ──────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if isBroadcaster() || isAdmin();
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Replays ─────────────────────────────────────────────
    match /replays/{replayId} {
      allow read: if true;
      allow create: if isBroadcaster() || isAdmin();
      allow update: if isSignedIn()
        && (resource.data.djUserId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.djUserId == request.auth.uid || isAdmin());
    }

    // ── User Favorites ──────────────────────────────────────
    match /userFavorites/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── User Likes ──────────────────────────────────────────
    match /userLikes/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── User Follows ────────────────────────────────────────
    match /userFollows/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // ── DJ Applications ─────────────────────────────────────
    match /dj_applications/{appId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── DA Applications ─────────────────────────────────────
    match /da_applications/{appId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Reports (signalements) ──────────────────────────────
    match /reports/{reportId} {
      // Anyone signed in can create a report
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      // Only the reporter can read their own report; admins can read all
      allow read: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      // Only admin can update (review) or delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Server-only
    }

    // ── User Follows: allow update for notificationsEnabled ──
    match /userFollows/{docId} {
      allow update: if isSignedIn()
        && resource.data.followerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationsEnabled']);
    }

    // ── Rate Limits ─────────────────────────────────────────
    match /_rateLimits/{docId} {
      allow read, write: if false; // Server-only
    }

    // ── Catch-all: deny everything else ─────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
